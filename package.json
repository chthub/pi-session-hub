{
  "name": "pi-session-hub",
  "version": "0.2.0",
  "description": "Cross-harness session hub for Pi: browse, search and continue sessions from Claude Code, Codex, OpenCode, Crush and JCode without leaving your chat.",
  "type": "module",
  "license": "MIT",
  "author": "Gateton",
  "keywords": [
    "pi-package",
    "pi",
    "sessions",
    "session",
    "resume",
    "handoff",
    "claude-code",
    "codex",
    "opencode",
    "crush",
    "jcode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gateton/pi-session-hub.git"
  },
  "homepage": "https://github.com/Gateton/pi-session-hub#readme",
  "bugs": {
    "url": "https://github.com/Gateton/pi-session-hub/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/Gateton/pi-session-hub/main/assets/session-hub.png"
  },
  "bin": {
    "pi-session-hub-web": "./bin/web.mjs"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "skills",
    "test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/acceptance.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:web": "node test/web.mjs && node test/web-open.mjs",
    "test:web:browser": "node test/web-browser.mjs",
    "web": "node bin/web.mjs",
    "prepublishOnly": "node test/acceptance.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5"
  }
}
