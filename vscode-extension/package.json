{
  "name": "pi-session-hub-vscode",
  "displayName": "Session Hub",
  "description": "Browse local coding-agent history and resume in native terminals, including over Remote SSH.",
  "version": "0.1.0",
  "publisher": "chthub",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/chthub/pi-session-hub" },
  "engines": { "vscode": "^1.99.0" },
  "extensionKind": ["workspace"],
  "categories": ["Other"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onView:sessionHub.sessions"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "colors": [{
      "id": "sessionHub.starredForeground",
      "description": "Session Hub 已加星标会话的标题颜色。",
      "defaults": { "dark": "#E2B647", "light": "#8A6000", "highContrast": "#FFD700", "highContrastLight": "#805500" }
    }],
    "viewsContainers": { "activitybar": [{ "id": "sessionHub", "title": "Session Hub", "icon": "media/session-hub.svg" }] },
    "views": { "sessionHub": [{ "type": "webview", "id": "sessionHub.sessions", "name": "会话历史" }] },
    "commands": [
      { "command": "sessionHub.refresh", "title": "Session Hub: 刷新索引", "icon": "$(refresh)" },
      { "command": "sessionHub.newSession", "title": "Session Hub: 新建会话", "icon": "$(add)" },
      { "command": "sessionHub.open", "title": "Session Hub: 打开会话" },
      { "command": "sessionHub.resume", "title": "Session Hub: 在终端中继续" },
      { "command": "sessionHub.copyId", "title": "Session Hub: 复制会话 ID" },
      { "command": "sessionHub.star", "title": "Session Hub: 加星标", "icon": "$(star-empty)" },
      { "command": "sessionHub.unstar", "title": "Session Hub: 取消星标", "icon": "$(star-full)" }
    ],
    "menus": {
      "view/title": [
        { "command": "sessionHub.newSession", "when": "view == sessionHub.sessions", "group": "navigation@0" },
        { "command": "sessionHub.refresh", "when": "view == sessionHub.sessions", "group": "navigation@1" }
      ],
      "webview/context": [
        { "command": "sessionHub.open", "when": "webviewId == sessionHub.sessions && webviewSection == session", "group": "1_open" },
        { "command": "sessionHub.resume", "when": "webviewId == sessionHub.sessions && webviewSection == session", "group": "1_open" },
        { "command": "sessionHub.copyId", "when": "webviewId == sessionHub.sessions && webviewSection == session", "group": "2_copy" },
        { "command": "sessionHub.star", "when": "webviewId == sessionHub.sessions && webviewSection == session && !sessionStarred", "group": "3_star" },
        { "command": "sessionHub.unstar", "when": "webviewId == sessionHub.sessions && webviewSection == session && sessionStarred", "group": "3_star" }
      ],
      "commandPalette": [
        { "command": "sessionHub.star", "when": "false" },
        { "command": "sessionHub.unstar", "when": "false" }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/node": "^22.20.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0"
  }
}
