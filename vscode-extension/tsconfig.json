{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "skipLibCheck": true,
    "paths": {
      "markdown-it": ["./node_modules/@types/markdown-it"],
      "katex": ["./node_modules/@types/katex"]
    }
  },
  "include": ["src/**/*.ts"]
}
